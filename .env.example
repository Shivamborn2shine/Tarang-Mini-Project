# Copy to .env for local Docker / Postgres runs
POSTGRES_USER=tarang
POSTGRES_PASSWORD=tarang_dev_only
POSTGRES_DB=tarang

# Local dev defaults to SQLite when Postgres is not running:
# TARANG_DATABASE_URL=sqlite:///./tarang_local.db
TARANG_DATABASE_URL=postgresql+psycopg://tarang:tarang_dev_only@127.0.0.1:5432/tarang
TARANG_HOST=127.0.0.1
TARANG_PORT=8000
